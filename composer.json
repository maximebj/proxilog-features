{
  "name": "proxilog/proxilog-features",
  "description": "Extension WordPress Proxilog Features",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "twig/twig": "~3.0"
  },
  "autoload": {
    "psr-4": {
      "proxilogFeatures\\": "includes/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('vendor/autoload.php') || copy('vendor/composer/autoload_real.php', 'vendor/autoload.php');\""
    ]
  }
}
